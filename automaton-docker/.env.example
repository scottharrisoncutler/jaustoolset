# .env.example — Copy to .env and fill in values before starting.
# These variables are passed into the automaton container.
#
# NEVER commit the real .env file to version control.

# Optional: pre-fund the automaton wallet (private key hex, no 0x prefix)
# AUTOMATON_PRIVATE_KEY=

# Optional: Conway API key (provisioned automatically on first run if omitted)
# CONWAY_API_KEY=

# Optional: name for the automaton (prompted interactively if omitted)
# AUTOMATON_NAME=
